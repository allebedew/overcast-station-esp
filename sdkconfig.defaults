# Осознанные отклонения от дефолтов ESP-IDF.
# Полный sdkconfig генерируется из этого файла и не хранится в git.

CONFIG_IDF_TARGET="esp32c6"

# 16 MB flash on the board; the custom partition table below needs the full
# size (default is 2 MB, which the table does not fit into).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Кастомная таблица разделов: два OTA-раздела по 4 МБ (см. partitions.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# OTA: новая прошивка должна подтвердиться после загрузки
# (esp_ota_mark_app_valid_cancel_rollback), иначе бутлоадер откатится
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Статистика времени выполнения задач — для показа загрузки CPU
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# Оптимизация по размеру
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Enlarge the LWIP BSD-socket pool (default 10). httpd (7 clients + listener),
# mDNS and SNTP already fill it, so outbound TLS clients (telegram, weather_api)
# could fail with "Failed to create socket / sock < 0". 16 is the LWIP max.
CONFIG_LWIP_MAX_SOCKETS=16

# The DHCP-supplied resolver on the deployment network drops queries often
# enough that a single getaddrinfo() fails (EAI_FAIL, 202) with the link up
# and healthy. LWIP walks its server list when a query goes unanswered, so
# give it a public one to fall back to; the DHCP servers are still tried first.
CONFIG_LWIP_FALLBACK_DNS_SERVER_SUPPORT=y
CONFIG_LWIP_FALLBACK_DNS_SERVER_ADDRESS="1.1.1.1"

# WireGuard runs its crypto on the LWIP task; the default 3 KiB stack is short
# for the handshake (X25519 in software).
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=5120

# No bridge is ever created: this is the only switch that turns on
# LWIP_ESP_NETIF_DATA, which makes esp_netif keep its handle in the netif's
# client data. Without it esp_netif reads `netif->state` of *every* lwip netif
# as its own handle, and the WireGuard interface -- added straight to lwip,
# with its own device there -- crashes the IDF netif callback as soon as it
# gets an address.
CONFIG_ESP_NETIF_BRIDGE_EN=y
