#pragma once

/* Copy to secrets.h (git-ignored) and fill in what this build needs. The file
 * itself is optional: every consumer below falls back to a default, and the
 * WireGuard block left out compiles the tunnel away entirely. */

/* Push notifications. Token from @BotFather, chat id from @userinfobot.
 * Either one empty disables the module; that is also the default. */
#define TELEGRAM_TOKEN   ""
#define TELEGRAM_CHAT_ID ""

/* Shared secret for network flashing: flash-ota.sh reads it out of this file.
 * Guards against a stray upload from the LAN or from AP mode. */
#define OTA_KEY "pick-your-own"

/* Own SoftAP, raised whenever no saved network answers. WPA2 needs 8 chars. */
#define WIFI_AP_PASSWORD "pick-your-own"

/* WireGuard. Drop this block to leave the tunnel out of the build; WG_PRIVATE_KEY
 * is what switches it on. Keys are base64, as printed by `wg genkey`/`wg pubkey`. */
#define WG_PRIVATE_KEY     "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
#define WG_PEER_PUBLIC_KEY "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB="

#define WG_ENDPOINT      "vpn.example.com" /* host or IP of the server */
#define WG_ENDPOINT_PORT 51820

/* This station's address inside the tunnel. The netmask decides what leaves
 * through it: /24 routes the whole tunnel subnet, /32 only the server itself.
 * Everything outside it (Telegram, the forecast, SNTP) keeps using Wi-Fi. */
#define WG_LOCAL_IP      "10.13.13.2"
#define WG_LOCAL_NETMASK "255.255.255.0"

/* Seconds between keepalives. Required behind NAT: the server can only reach
 * the station through a mapping the station itself keeps open. */
#define WG_KEEPALIVE_S 25
