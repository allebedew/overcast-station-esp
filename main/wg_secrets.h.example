#pragma once

/* Copy to wg_secrets.h (git-ignored) and fill in. Without that copy the
 * WireGuard module compiles to a no-op and the tunnel is simply absent.
 * Keys are base64, as printed by `wg genkey` and `wg pubkey`. */

#define WG_PRIVATE_KEY     "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
#define WG_PEER_PUBLIC_KEY "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB="

#define WG_ENDPOINT      "vpn.example.com" /* host or IP of the server */
#define WG_ENDPOINT_PORT 51820

/* This station's address inside the tunnel. The netmask decides what leaves
 * through it: /24 routes the whole tunnel subnet, /32 only the server itself.
 * Everything outside it (Telegram, the forecast, SNTP) keeps using Wi-Fi. */
#define WG_LOCAL_IP      "10.13.13.2"
#define WG_LOCAL_NETMASK "255.255.255.0"

/* Seconds between keepalives. Required behind NAT: the server can only reach
 * the station through a mapping the station itself keeps open. */
#define WG_KEEPALIVE_S 25
